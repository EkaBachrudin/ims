# --------------------------------------------
# PostgreSQL (dipakai oleh docker-compose db)
# --------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=wms_db

# Port host (ubah jika 5432/3000 sudah dipakai)
DB_HOST_PORT=5433
BACKEND_HOST_PORT=3001
# Port host frontend production (nginx di dalam container listen :80)
FRONTEND_HOST_PORT=8080

# --------------------------------------------
# Kredensial service (dipakai docker compose)
# --------------------------------------------
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=123456:ABC...
INTERNAL_API_KEY=change_me_internal

# Role DB read-only untuk runtime AI Agent (least privilege)
AI_DB_USER=ai_agent
AI_DB_PASSWORD=ai_agent_secret

# --------------------------------------------
# JWT (dipakai backend via docker compose)
# --------------------------------------------
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --------------------------------------------
# Opsional (override default di compose)
# --------------------------------------------
OPENAI_MODEL=gpt-4o-mini
# Buat model reasoning (mis. gpt-6-luna) yang memakai function tools: isi "none".
# Biarkan kosong untuk model non-reasoning (mis. gpt-4o-mini). Nilai: none|low|medium|high
OPENAI_REASONING_EFFORT=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
