NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/wms_db
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173
INTERNAL_API_KEY=change_me_internal

# Notifikasi Telegram via ai-agent (kosongkan untuk menonaktifkan)
AI_AGENT_URL=http://localhost:8080
# Base URL frontend untuk deep-link PO (mis. http://localhost:5173/purchase-orders/<id>)
WEB_APP_URL=http://localhost:5173

# Re-ingest otomatis knowledge base saat dokumen dibuat/diubah/dinonaktifkan (default: true)
RAG_AUTO_INGEST=true
